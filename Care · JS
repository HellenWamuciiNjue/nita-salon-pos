    <h3 class="word-title">${esc(w.title)}</h3>
    <blockquote class="word-verse">“${esc(w.verse)}”<cite>${esc(w.ref)} (KJV)</cite></blockquote>
    <p class="word-body">${esc(w.body)}</p>
