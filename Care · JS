  const CU = ctx.getCU(); if (!CU || CU.role === 'admin') return;
  const p = personal();

  $('msHero').innerHTML = `
    <div class="ms-hero">
      <div>
        <div class="ms-hi">${greeting()}</div>
        <div class="ms-name">${esc(p.first)}, this space is yours.</div>
        <div class="ms-sub">A daily word, a place to talk things through, and a way to ask for help if you ever need it.</div>
      </div>
      <div class="ms-stats">
        <div class="ms-stat"><b>${fmtKsh(p.ydC)}</b><span>Yesterday</span></div>
