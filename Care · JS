// ============================================================
//  care.js — "My Space" for staff + "Care Inbox" for the manager
//
//  PRIVACY MODEL (important, and shown to staff on screen):
//   • The Buddy chat is automated and private. NOTHING typed there is saved.
//   • Something only reaches the manager if the staff member taps
//     "Send to my manager" after seeing exactly what will be sent.
//   • Shared requests are stored in a NEW Firestore collection:
//     `supportRequests`. Existing collections are never touched.
// ============================================================
import { collection, addDoc, updateDoc, doc, onSnapshot, query, where }
  from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";
import {
  DAILY_WORDS, BOOST_LINES, MOODS, TOPICS, HELP_TYPES, URGENCY,
  TOPIC_OPEN, TOPIC_TIPS, PRAYERS, HELPLINES, RX
} from './content.js';

let ctx = null;
let REQS = [];
let unsubReqs = null;
let wordShift = 0;
let bannerHidden = false;
let inboxFilter = 'open';
let B = null;          // buddy conversation state (memory only)
let buddyBusy = false;

const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const $ = id => document.getElementById(id);
const sleep = ms => new Promise(r => setTimeout(r, ms));
const hashStr = s => { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; };
const dayStr = off => { const d = new Date(); d.setDate(d.getDate() + off); return d.toISOString().split('T')[0]; };
const firstName = n => (n || '').trim().split(/\s+/)[0] || 'friend';
const fmtKsh = n => 'Ksh ' + Math.round(n || 0).toLocaleString();
const liveTx = (arr, name) => arr.filter(t => ctx.norm(t.staff) === ctx.norm(name) && t.status !== 'DELETED' && t.status !== 'VOID');

function timeAgo(iso) {
  if (!iso) return '';
  const m = Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
  if (m < 1) return 'just now';
  if (m < 60) return m + ' min ago';
  const h = Math.floor(m / 60);
  if (h < 24) return h + ' h ago';
  const d = Math.floor(h / 24);
  return d === 1 ? 'yesterday' : d + ' days ago';
}

// ------------------------------------------------------------
//  INIT / LISTENERS
// ------------------------------------------------------------
export function initCare(context) { ctx = context; }

export function startCare() {
  stopCare();
  const CU = ctx.getCU();
  if (!CU) return;
  try {
    const q = CU.role === 'admin'
      ? collection(ctx.db, 'supportRequests')
      : query(collection(ctx.db, 'supportRequests'), where('staff', '==', CU.name)); // staff only download their OWN requests
    unsubReqs = onSnapshot(q, snap => {
      REQS = [];
      snap.forEach(d => REQS.push({ ...d.data(), id: d.id }));
      REQS.sort((a, b) => (b.createdAt || '').localeCompare(a.createdAt || ''));
      updateBadges();
      renderBanner();
      const active = document.querySelector('.page.active')?.id;
      if (active === 'page-careInbox') renderCareInbox();
      if (active === 'page-mySpace') renderRequestsList();
    }, err => console.warn('supportRequests listener:', err.message));
  } catch (e) { console.warn('Care listener failed', e); }
}

export function stopCare() {
  if (unsubReqs) { try { unsubReqs(); } catch (e) { } unsubReqs = null; }
  REQS = []; B = null; bannerHidden = false; wordShift = 0; buddyBusy = false;
  // Wipe anything on screen so the next person on a shared phone never sees it
  ['boostBanner', 'msHero', 'msWord', 'msBuddy', 'msRequests', 'careList', 'careFilters'].forEach(id => { const e = document.getElementById(id); if (e) e.innerHTML = ''; });
}

function updateBadges() {
  const CU = ctx.getCU(); if (!CU) return;
  const n = CU.role === 'admin'
    ? REQS.filter(r => r.status === 'new').length
    : REQS.filter(r => r.adminReply && !r.replySeen).length;
  document.querySelectorAll('[data-care-badge]').forEach(el => {
    el.textContent = n > 0 ? n : '';
    el.style.display = n > 0 ? 'inline-flex' : 'none';
  });
}

// ------------------------------------------------------------
//  PERSONAL DATA (everything is specific to the logged-in person)
// ------------------------------------------------------------
function personal() {
  const CU = ctx.getCU(), TX = ctx.getTX(), SALES = ctx.getSales();
  const name = CU.name;
  const my = liveTx(TX, name);
  const td = ctx.todayStr();
  const yd = dayStr(-1), d2 = dayStr(-2), tm = dayStr(1);
  const comm = arr => arr.reduce((a, t) => a + (t.commission || 0), 0);
  const ydC = comm(my.filter(t => t.date === yd));
  const monthC = comm(my.filter(t => t.date && t.date.startsWith(td.substring(0, 7))));
  const wkStart = new Date(); wkStart.setDate(wkStart.getDate() - wkStart.getDay());
  const wkStr = wkStart.toISOString().split('T')[0];
  const weekC = comm(my.filter(t => t.date >= wkStr));
  const hadYd = my.some(t => t.date === yd), hadD2 = my.some(t => t.date === d2);
  const offTomorrow = (ctx.getDayoffs() || []).some(d => d.date === tm && ctx.norm(d.staff) === ctx.norm(name));
  const streak = ctx.getStreak(name);
  const goal = ctx.getGoal(name);
  const goalPct = goal ? Math.min(100, Math.round(monthC / goal * 100)) : null;

  // "Clean records" streak: days with sales logged AND payment proof AND a product check
  const mySales = SALES.filter(s => ctx.norm(s.staff) === ctx.norm(name) && s.status !== 'VOID' && s.status !== 'DELETED');
  const dayClean = date => {
    const tx = my.filter(t => t.date === date);
    if (!tx.length) return null;
    const proofOk = tx.every(t => !(t.status !== 'DEBT' && t.payment && t.payment !== 'Cash') || t.payTime || t.payRef || t.payerName);
    const prodOk = mySales.some(s => s.date === date) || tx.some(t => t.noProductReason);
    const hasNew = tx.some(t => t.payTime || t.payRef || t.payerName || t.noProductReason) || mySales.some(s => s.date === date);
    return hasNew && proofOk && prodOk;
  };
  let clean = 0;
  for (let i = 0; i < 60; i++) {
    const r = dayClean(dayStr(-i));
    if (r === null) { if (i === 0) continue; else break; }
    if (r) clean++; else break;
  }

  let pool = 'good';
  if (!hadYd && hadD2) pool = 'return';
  else if (offTomorrow) pool = 'offday';
  else if (ydC < 400) pool = 'quiet';

  return { name, first: firstName(name), ydC, weekC, monthC, streak, goal, goalPct, clean, pool, myCount: my.length };
}

function greeting() {
  const h = new Date().getHours();
  return h < 12 ? 'Good morning ☀️' : h < 17 ? 'Good afternoon 🌤️' : 'Good evening 🌙';
}

// ------------------------------------------------------------
//  DAILY WORD  (different for every person, every day)
// ------------------------------------------------------------
function wordFor(name) {
  const dayNum = Math.floor(Date.now() / 86400000);
  const idx = (hashStr(ctx.norm(name)) + dayNum + wordShift) % DAILY_WORDS.length;
  return DAILY_WORDS[idx];
}

// ------------------------------------------------------------
//  BOOST BANNER (replaces the old pop-up after login)
// ------------------------------------------------------------
export function renderBanner() {
  const el = $('boostBanner'); if (!el) return;
  const CU = ctx.getCU(); if (!CU) { el.innerHTML = ''; return; }

  if (CU.role === 'admin') {
    const n = REQS.filter(r => r.status === 'new').length;
    const urgent = REQS.filter(r => r.status === 'new' && r.urgency === 'urgent').length;
    el.innerHTML = n ? `
      <div class="boost boost-admin">
        <div class="boost-top"><span class="boost-hi">💛 Team care</span></div>
        <div class="boost-line">${n} team member${n > 1 ? 's' : ''} asked for support${urgent ? ` — <b style="color:#fca5a5">${urgent} urgent</b>` : ''}.</div>
        <div class="boost-actions"><button class="boost-btn" onclick="goPage('careInbox')">Open Care Inbox →</button></div>
      </div>` : '';
    return;
  }

  if (bannerHidden) { el.innerHTML = ''; return; }
  const p = personal();
  const w = wordFor(p.name);
  const seed = hashStr(ctx.norm(p.name) + ctx.todayStr());
  const main = ctx.pickMsg(p.pool, seed);
  const pool = (BOOST_LINES[p.pool] || []).concat(BOOST_LINES.any);
  const extra = pool[(seed >>> 3) % pool.length];
  const replied = REQS.filter(r => r.adminReply && !r.replySeen).length;

  const chips = [];
  if (p.ydC > 0) chips.push(`💰 Yesterday ${fmtKsh(p.ydC)}`);
  if (p.streak > 0) chips.push(`🔥 ${p.streak}-day streak`);
  if (p.clean > 0) chips.push(`✅ ${p.clean}-day clean records`);
  if (p.goalPct !== null) chips.push(`🎯 Goal ${p.goalPct}%`);

  el.innerHTML = `
    <div class="boost">
      <button class="boost-x" aria-label="Hide" onclick="careHideBanner()">×</button>
      <div class="boost-top"><span class="boost-hi">${greeting()}, ${esc(p.first)}</span></div>
      <div class="boost-line">${esc(main || 'Great to have you here!')}</div>
      <div class="boost-sub">${esc(extra)}</div>
      ${chips.length ? `<div class="boost-chips">${chips.map(c => `<span>${c}</span>`).join('')}</div>` : ''}
      <div class="boost-actions">
        <button class="boost-btn" onclick="goPage('mySpace')">🙏 Today's Word: ${esc(w.title)}</button>
        <button class="boost-btn ghost" onclick="goPage('mySpace');setTimeout(()=>document.getElementById('msBuddy')?.scrollIntoView({behavior:'smooth'}),150)">💛 How are you?</button>
        ${replied ? `<button class="boost-btn warm" onclick="goPage('mySpace')">💌 Your manager replied</button>` : ''}
      </div>
    </div>`;
}
window.careHideBanner = () => { bannerHidden = true; const e = $('boostBanner'); if (e) e.innerHTML = ''; };

